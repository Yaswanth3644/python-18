class Solution:
    def maxIndexDiff(self, arr):
        n = len(arr)
        
        # Step 1: Build prefix minimums
        leftMin = [0] * n
        leftMin[0] = arr[0]
        for i in range(1, n):
            leftMin[i] = min(leftMin[i-1], arr[i])
        
        # Step 2: Build suffix maximums
        rightMax = [0] * n
        rightMax[n-1] = arr[n-1]
        for j in range(n-2, -1, -1):
            rightMax[j] = max(rightMax[j+1], arr[j])
        
        # Step 3: Two-pointer traversal
        i, j = 0, 0
        maxDiff = -1
        while i < n and j < n:
            if leftMin[i] <= rightMax[j]:
                maxDiff = max(maxDiff, j - i)
                j += 1
            else:
                i += 1
        
        return maxDiff
